# ==============================================================================
# Central Arabic AI API — Environment Configuration Template
# NOTE: Never commit secret values or API keys to version control.
# ==============================================================================

# Core Service Binding & Environment
CENTRAL_AI_HOST=0.0.0.0
CENTRAL_AI_PORT=8000
CENTRAL_AI_ENV=staging
CENTRAL_AI_TIMEOUT=120.0
CENTRAL_AI_LOG_FORMAT=json

# Server Engine: http (built-in) or asgi (uvicorn high-throughput)
CENTRAL_AI_SERVER_ENGINE=asgi

# Active Inference Provider: mock | ollama | mlx_jais | hosted
# Default is 'mock' for secure zero-credential container startup
CENTRAL_AI_PROVIDER=mock
CENTRAL_AI_MODEL=qwen3:4b
CENTRAL_AI_FALLBACK_PROVIDER=mock
CENTRAL_AI_FALLBACK_MODEL=qwen3:4b

# Central API Gateway Authentication (Required for protected endpoints in staging/prod)
CENTRAL_AI_API_KEY=YOUR_SECURE_GATEWAY_API_KEY_HERE

# CORS Allowed Origins (Comma-separated exact origins)
CENTRAL_AI_CORS_ORIGINS=https://ai.peregrineacademy.in,http://localhost:3000,http://localhost:3005

# Request Body Limit (DoS guard, in bytes; default 2 MB = 2097152)
CENTRAL_AI_MAX_BODY_BYTES=2097152

# Cloud Hosted Inference (e.g. HUMAIN / RunPod / vLLM / OpenAI)
HOSTED_ENDPOINT=https://api.your-inference-host.com/v1
HOSTED_API_KEY=YOUR_INFERENCE_BEARER_TOKEN_HERE

# Local Development Endpoints (if hosting inference locally)
OLLAMA_ENDPOINT=http://127.0.0.1:11434
MLX_ENDPOINT=http://127.0.0.1:8080/v1

# Resource & Rate Limiting Controls
CENTRAL_AI_SEQUENTIAL_LOCK=true
CENTRAL_AI_ENFORCE_DISK_LIMIT=true
CENTRAL_AI_MIN_DISK_FREE_GB=15.0
CENTRAL_AI_RATE_LIMIT_ENABLED=true
CENTRAL_AI_RATE_LIMIT_RPM=60
CENTRAL_AI_MAX_CONCURRENCY=10

# Continuous Learning & Data Storage (Persistent Volume Path)
CENTRAL_AI_DATA_DIR=/app/data
CENTRAL_AI_WORKER_AUTO_START=true
CENTRAL_AI_WORKER_INTERVAL=300
